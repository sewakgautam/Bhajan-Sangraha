rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /bhajans/{doc} {
      allow read: if resource.data.is_published == true;
      allow write: if false;
    }
    match /categories/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Force-update gate (see lib/services/update_service.dart). Must be
    // readable pre-auth, since it's checked before sign-in even happens.
    match /app_config/{doc} {
      allow read: if true;
      allow write: if false;
    }

    match /gita_quotes/{doc} {
      allow read: if resource.data.is_active == true;
      allow write: if false;
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/bookmarks/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
